#!/bin/bash
# Mise à jour système ; les notifications sont gérées dans la session utilisateur.
set -Eeuo pipefail
umask 022
export LC_ALL=C
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

if [ "$EUID" -ne 0 ]; then
    echo "Ce script doit être lancé en tant que root." >&2
    exit 1
fi

STATE_DIR="/var/lib/fedora-auto-update"
[ ! -L "$STATE_DIR" ] || { echo "Dossier d'état symbolique refusé" >&2; exit 1; }
install -d -m 0755 "$STATE_DIR"
[ "$(stat -c '%u' "$STATE_DIR")" -eq 0 ] || exit 1
[ ! -L "$STATE_DIR/install.lock" ] && [ ! -L "$STATE_DIR/update.lock" ] || exit 1
# Attendre une installation avant de commencer une nouvelle transaction.
exec 8>"$STATE_DIR/install.lock"
flock -s 8
exec 9>"$STATE_DIR/update.lock"
flock -n 9 || exit 0

WORK_DIR="$(mktemp -d "$STATE_DIR/.work.XXXXXX")"
START_TIME="$(date +%s)"
RUN_ID="$(date +%s%N)-$$"
FINISHED=0

# Un document atomique contient toutes les étapes de la dernière exécution.
# Les fichiers texte restent disponibles pour la consultation en terminal.
set_status() {
    python3 - "$STATE_DIR" "$RUN_ID" "$1" "$2" <<'PYTHON'
import json, os, pathlib, sys, tempfile, time
root, run_id, status, details = sys.argv[1:]
root = pathlib.Path(root)
boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
def read(name):
    try:
        return json.loads((root / name).read_text())
    except (FileNotFoundError, ValueError):
        return {}
def publish(name, value):
    fd, temporary = tempfile.mkstemp(dir=(root / name).parent, prefix=".")
    try:
        with os.fdopen(fd, "w") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, root / name)
        directory = os.open((root / name).parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
def save_result(state):
    encoded = json.dumps(state, ensure_ascii=False)
    publish("last-result.json", encoded)
    publish("last-result.txt", state["events"][-1]["details"] + "\n")
    history = root / "history"
    history.mkdir(exist_ok=True, mode=0o755)
    publish(f"history/{time.time_ns()}.json", encoded)
    for old in sorted(history.glob("*.json"))[:-20]:
        old.unlink()
previous = read("state.json")
events = []
if previous.get("run_id") == run_id:
    events = previous.get("events", [])
elif previous.get("events") and previous["events"][-1]["status"] not in ("SUCCESS", "ERROR"):
    previous["events"].append({
        "status": "ERROR",
        "details": "L'exécution précédente a été interrompue sans résultat final. Une nouvelle tentative démarre."
    })
    previous["failures"] = read("last-result.json").get("failures", 0) + 1
    save_result(previous)
    events.append({"status": "RECOMMENDATION", "details": previous["events"][-1]["details"]})
events.append({"status": status, "details": details})
state = {"run_id": run_id, "boot_id": boot_id, "events": events}
if status in ("SUCCESS", "ERROR"):
    advice = [event["details"] for event in events if event["status"] == "RECOMMENDATION"]
    if advice:
        details += "\n\nRecommandations :\n" + "\n".join(advice)
        events[-1]["details"] = details
    state["failures"] = 0 if status == "SUCCESS" else read("last-result.json").get("failures", 0) + 1
    if state["failures"] >= 3:
        details += "\nPlusieurs tentatives ont échoué. Consultez les logs avant une relance manuelle."
        events[-1]["details"] = details
    save_result(state)
publish("details", details + "\n")
publish("status", status + "\n")
publish("run-id", run_id + "\n")
publish("state.json", json.dumps(state, ensure_ascii=False))
PYTHON
}

cleanup() {
    local rc=$?
    trap - EXIT
    if [ "$FINISHED" -eq 0 ]; then
        set_status ERROR "Exécution interrompue (code $rc). Consultez journalctl -u fedora-auto-update.service." || true
        [ "$rc" -ne 0 ] || rc=1
    fi
    rm -rf -- "$WORK_DIR"
    exit "$rc"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Log persistant de la dernière exécution, en complément de journald.
install -d -m 0755 "$STATE_DIR/logs"
if [ -f "$STATE_DIR/last-run.log" ]; then
    mv -fT "$STATE_DIR/last-run.log" "$STATE_DIR/logs/$RUN_ID.log"
fi
python3 - "$STATE_DIR/logs" <<'PYTHON'
import pathlib, sys
for old in sorted(pathlib.Path(sys.argv[1]).glob("*.log"))[:-5]:
    old.unlink()
PYTHON
exec > >(python3 -u -c '
import pathlib, sys
remaining = 10 * 1024 * 1024
with pathlib.Path(sys.argv[1]).open("wb") as log:
    while chunk := sys.stdin.buffer.read1(8192):
        sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()
        if remaining:
            part = chunk[:remaining]
            log.write(part)
            log.flush()
            remaining -= len(part)
' "$STATE_DIR/last-run.log") 2>&1
echo "Fedora automatic update — $(date --iso-8601=seconds) — $RUN_ID"

# Seuil conservateur : éviter de commencer une transaction avec un disque saturé.
for mount in / /var /boot; do
    available="$(df -Pk "$mount" | awk 'NR==2 {print $4}')"
    if [[ "$available" =~ ^[0-9]+$ ]] && [ "$available" -lt 204800 ]; then
        set_status ERROR "Espace disque faible sur $mount (moins de 200 Mio libres).
Libérez de l'espace avant de relancer la mise à jour. Aucun paquet n'a été modifié."
        FINISHED=1
        exit 78
    fi
done

set_status RUNNING_DNF "Étape 1/3 — DNF / RPM
Recherche et installation des mises à jour Fedora, kernel et KDE Plasma."

RPM_COUNT="indisponible"
RPM_BEFORE=0
rpm -qa --qf '%{NAME}\t%{ARCH}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\n' > "$WORK_DIR/rpm-before" || RPM_BEFORE=$?
DNF_STATUS=0
dnf5 upgrade --refresh -y || DNF_STATUS=$?
RPM_AFTER=0
rpm -qa --qf '%{NAME}\t%{ARCH}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\n' > "$WORK_DIR/rpm-after" || RPM_AFTER=$?
if [ "$RPM_BEFORE" -eq 0 ] && [ "$RPM_AFTER" -eq 0 ]; then
    RPM_COUNT="$(python3 - "$WORK_DIR/rpm-before" "$WORK_DIR/rpm-after" <<'PYTHON'
import pathlib, sys
before, after = (set(pathlib.Path(p).read_text().splitlines()) for p in sys.argv[1:])
# Les nouvelles versions et nouveaux paquets (dont les kernels) sont comptés,
# sans compter une seconde fois la suppression de l'ancienne version.
print(len(after - before))
PYTHON
)"
fi

set_status RUNNING_FLATPAK "Étape 2/3 — Flatpak système
DNF : code $DNF_STATUS ; $RPM_COUNT paquet(s) installé(s) ou mis à jour."

FLATPAK_COUNT="indisponible"
FLATPAK_BEFORE=0
flatpak list --system --app --columns=ref,active > "$WORK_DIR/flatpak-before" || FLATPAK_BEFORE=$?
FLATPAK_STATUS=0
flatpak update --system -y --noninteractive || FLATPAK_STATUS=$?
FLATPAK_AFTER=0
flatpak list --system --app --columns=ref,active > "$WORK_DIR/flatpak-after" || FLATPAK_AFTER=$?
if [ "$FLATPAK_BEFORE" -eq 0 ] && [ "$FLATPAK_AFTER" -eq 0 ]; then
    FLATPAK_COUNT="$(python3 - "$WORK_DIR/flatpak-before" "$WORK_DIR/flatpak-after" <<'PYTHON'
import pathlib, sys
def snapshot(path):
    return dict(line.split("\t", 1) for line in pathlib.Path(path).read_text().splitlines() if line)
before, after = map(snapshot, sys.argv[1:])
print(sum(before.get(ref) != commit for ref, commit in after.items()))
PYTHON
)" || FLATPAK_COUNT="indisponible"
fi

set_status RUNNING_FIRMWARE "Étape 3/3 — Firmware
DNF : code $DNF_STATUS ; $RPM_COUNT paquet(s).
Flatpak : code $FLATPAK_STATUS ; $FLATPAK_COUNT application(s).
Recherche des mises à jour firmware."

FWUPD_REFRESH_STATUS=0
fwupdmgr refresh || FWUPD_REFRESH_STATUS=$?
FWUPD_STATUS=0
fwupdmgr update -y --no-reboot-check || FWUPD_STATUS=$?
# Code documenté par fwupd : aucune action nécessaire.
[ "$FWUPD_REFRESH_STATUS" -ne 2 ] || FWUPD_REFRESH_STATUS=0
[ "$FWUPD_STATUS" -ne 2 ] || FWUPD_STATUS=0

# Une recommandation précise seulement si le kernel installé diffère du kernel actif.
# Cela évite de dépendre d'un plugin DNF optionnel ou de confondre une erreur avec un besoin de reboot.
if rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' > "$WORK_DIR/kernels"; then
    running_kernel="$(uname -r)"
    newest_kernel="$(sort -V "$WORK_DIR/kernels" | tail -n 1)"
    if [ -n "$newest_kernel" ] && [ "$newest_kernel" != "$running_kernel" ]; then
        set_status RECOMMENDATION "Un kernel installé diffère du kernel actif ($running_kernel).
Un redémarrage manuel permet de sélectionner le kernel installé ($newest_kernel).
Enregistrez votre travail avant de redémarrer."
    fi
fi

RESULT=SUCCESS
TITLE="Mise à jour terminée"
for rc in "$DNF_STATUS" "$FLATPAK_STATUS" "$FWUPD_REFRESH_STATUS" "$FWUPD_STATUS"; do
    if [ "$rc" -ne 0 ]; then
        RESULT=ERROR
        TITLE="Mise à jour terminée avec erreur — consultez les logs. Les reprises automatiques sont limitées à trois démarrages par 24 heures."
    fi
done
label() { if [ "$1" -eq 0 ]; then printf 'OK'; else printf 'ERREUR (code %s)' "$1"; fi; }
ELAPSED=$(( $(date +%s) - START_TIME ))
set_status "$RESULT" "$TITLE

DNF / RPM : $(label "$DNF_STATUS") — $RPM_COUNT paquet(s) installé(s) ou mis à jour
Flatpak : $(label "$FLATPAK_STATUS") — $FLATPAK_COUNT application(s) installée(s) ou mise(s) à jour
Firmware : $(label "$FWUPD_STATUS")
Métadonnées firmware : $(label "$FWUPD_REFRESH_STATUS")

Durée : $((ELAPSED / 60)) min $((ELAPSED % 60)) s
$(date '+%d/%m/%Y %H:%M:%S')
Aucun redémarrage automatique. Certains changements nécessitent un redémarrage manuel.
Logs : journalctl -u fedora-auto-update.service"
FINISHED=1
[ "$RESULT" = SUCCESS ]
