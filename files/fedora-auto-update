#!/bin/bash

set -u

STATE_DIR="/run/fedora-auto-update"
STATE_FILE="$STATE_DIR/status"
DETAIL_FILE="$STATE_DIR/details"
RUN_ID_FILE="$STATE_DIR/run-id"

mkdir -p "$STATE_DIR"
chmod 755 "$STATE_DIR"

START_TIME=$(date +%s)
RUN_ID="$(date +%s)-$$"

echo "$RUN_ID" > "$RUN_ID_FILE"
chmod 644 "$RUN_ID_FILE"

set_status() {
    echo "$1" > "$STATE_FILE"
    printf "%s\n" "$2" > "$DETAIL_FILE"
    chmod 644 "$STATE_FILE" "$DETAIL_FILE"
}

duration() {
    NOW=$(date +%s)
    ELAPSED=$((NOW - START_TIME))
    printf "%d min %02d s" $((ELAPSED / 60)) $((ELAPSED % 60))
}

get_last_dnf_transaction_id() {
    dnf history list --json 2>/dev/null |
        python3 -c '
import json
import sys
try:
    data = json.load(sys.stdin)
    if not data:
        print(0)
    else:
        print(max(int(x.get("id", 0)) for x in data))
except Exception:
    print(0)
'
}

get_dnf_stats() {
    dnf history info last --json 2>/dev/null |
        python3 -c '
import json
import sys
try:
    data = json.load(sys.stdin)
    if not data:
        print("0 0 0 0 0")
        sys.exit(0)

    tx = data[0]
    packages = tx.get("packages", [])

    upgraded = installed = removed = downgraded = 0

    for pkg in packages:
        action = str(pkg.get("action", "")).lower()

        if action == "upgrade":
            upgraded += 1
        elif action == "install":
            installed += 1
        elif action == "remove":
            removed += 1
        elif action == "downgrade":
            downgraded += 1

    print(upgraded, installed, removed, downgraded, len(packages))
except Exception:
    print("0 0 0 0 0")
'
}

echo "========================================"
echo "Fedora automatic update"
echo "Start  : $(date)"
echo "Run ID : $RUN_ID"
echo "========================================"

# DNF / RPM
set_status \
    "RUNNING_DNF" \
    "Étape 1/3 — DNF / RPM

Recherche et installation des mises à jour :
• Fedora
• Kernel
• KDE Plasma
• Bibliothèques
• Paquets RPM"

DNF_TRANSACTION_BEFORE="$(get_last_dnf_transaction_id)"

dnf upgrade --refresh -y
DNF_STATUS=$?

DNF_TRANSACTION_AFTER="$(get_last_dnf_transaction_id)"

DNF_UPGRADED=0
DNF_INSTALLED=0
DNF_REMOVED=0
DNF_DOWNGRADED=0
DNF_TOTAL=0

if [ "$DNF_TRANSACTION_AFTER" != "$DNF_TRANSACTION_BEFORE" ] &&
   [ "$DNF_TRANSACTION_AFTER" != "0" ]; then

    read \
        DNF_UPGRADED \
        DNF_INSTALLED \
        DNF_REMOVED \
        DNF_DOWNGRADED \
        DNF_TOTAL \
        <<< "$(get_dnf_stats)"
fi

if [ "$DNF_STATUS" -eq 0 ]; then
    DNF_RESULT="✓"
else
    DNF_RESULT="✕"
fi

# Flatpak
set_status \
    "RUNNING_FLATPAK" \
    "Étape 2/3 — Flatpak

DNF / RPM : $DNF_RESULT
Paquets modifiés : $DNF_TOTAL

Recherche des mises à jour Flatpak…"

FLATPAK_UPDATES="$(
    flatpak remote-ls \
        --system \
        --updates \
        --columns=application \
        2>/dev/null |
    sed '/^[[:space:]]*$/d'
)"

if [ -n "$FLATPAK_UPDATES" ]; then
    FLATPAK_COUNT="$(
        printf "%s\n" "$FLATPAK_UPDATES" |
        sort -u |
        wc -l
    )"
else
    FLATPAK_COUNT=0
fi

flatpak update --system -y --noninteractive
FLATPAK_STATUS=$?

if [ "$FLATPAK_STATUS" -eq 0 ]; then
    FLATPAK_RESULT="✓"
else
    FLATPAK_RESULT="✕"
fi

# Firmware
set_status \
    "RUNNING_FIRMWARE" \
    "Étape 3/3 — Firmware

DNF / RPM : $DNF_RESULT  $DNF_TOTAL paquet(s)
Flatpak   : $FLATPAK_RESULT  $FLATPAK_COUNT mise(s) à jour

Recherche des mises à jour firmware…"

fwupdmgr refresh --force
FWUPD_REFRESH_STATUS=$?

fwupdmgr update -y
FWUPD_STATUS=$?

if [ "$FWUPD_REFRESH_STATUS" -eq 0 ] &&
   [ "$FWUPD_STATUS" -eq 0 ]; then
    FWUPD_RESULT="✓"
else
    FWUPD_RESULT="✕"
fi

TOTAL_UPDATES=$((DNF_TOTAL + FLATPAK_COUNT))
DURATION="$(duration)"
DATE="$(date '+%d/%m/%Y %H:%M:%S')"

if [ "$DNF_STATUS" -eq 0 ] &&
   [ "$FLATPAK_STATUS" -eq 0 ] &&
   [ "$FWUPD_REFRESH_STATUS" -eq 0 ] &&
   [ "$FWUPD_STATUS" -eq 0 ]; then

    set_status \
        "SUCCESS" \
        "Mise à jour terminée

DNF / RPM      $DNF_RESULT  $DNF_TOTAL paquet(s)
  • mis à jour : $DNF_UPGRADED
  • installés  : $DNF_INSTALLED
  • supprimés  : $DNF_REMOVED

Flatpak        $FLATPAK_RESULT  $FLATPAK_COUNT mise(s) à jour
Firmware       $FWUPD_RESULT

Total : $TOTAL_UPDATES mise(s) à jour

Durée : $DURATION
$DATE"

    exit 0
fi

set_status \
    "ERROR" \
    "Mise à jour terminée avec erreur

DNF / RPM      $DNF_RESULT  $DNF_TOTAL paquet(s)
  • mis à jour : $DNF_UPGRADED
  • installés  : $DNF_INSTALLED
  • supprimés  : $DNF_REMOVED

Flatpak        $FLATPAK_RESULT  $FLATPAK_COUNT mise(s) à jour
Firmware       $FWUPD_RESULT

Total : $TOTAL_UPDATES mise(s) à jour

Durée : $DURATION
$DATE

Consultez journalctl pour les détails."

exit 1
