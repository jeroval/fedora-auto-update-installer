[Unit]
Description=Fedora Complete Automatic Update
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fedora-auto-update

Restart=on-failure
RestartSec=2min

TimeoutStartSec=60min

Nice=10
IOSchedulingClass=idle
