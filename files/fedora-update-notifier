#!/bin/bash
# Lecture des événements publiés par le service système, sans privilèges root.
set -Eeuo pipefail
umask 077

STATE_FILE="/var/lib/fedora-auto-update/state.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/fedora-auto-update"
CACHE_FILE="$CACHE_DIR/last-event"
mkdir -p "$CACHE_DIR"
exec 9>"$CACHE_DIR/notifier.lock"
flock -n 9 || exit 0
[ -f "$STATE_FILE" ] || exit 0

# notify-send contacte directement le serveur et peut demander son activation.
# Un précontrôle busctl | grep -q peut produire un faux échec avec pipefail
# (SIGPIPE), et masquer la véritable raison d'un envoi impossible.

EVENTS="$(mktemp "$CACHE_DIR/.events.XXXXXX")"
trap 'rm -f -- "$EVENTS"' EXIT
python3 - "$STATE_FILE" "$CACHE_FILE" > "$EVENTS" <<'PYTHON'
import json, pathlib, sys
state = json.loads(pathlib.Path(sys.argv[1]).read_text())
try:
    last = pathlib.Path(sys.argv[2]).read_text().strip()
except FileNotFoundError:
    last = ""
boot_id = pathlib.Path("/proc/sys/kernel/random/boot_id").read_text().strip()
if state.get("boot_id", boot_id) != boot_id and state["events"][-1]["status"] not in ("SUCCESS", "ERROR"):
    state["events"] = [{"status": "ERROR", "details":
        "La dernière mise à jour a été interrompue par un arrêt de la machine. Une vérification est prévue après le démarrage."}]
    state["run_id"] += ":interrupted"
events = [
    (f'{state["run_id"]}:{i}', event["status"], event["details"])
    for i, event in enumerate(state["events"])
]
ids = [event[0] for event in events]
start = ids.index(last) + 1 if last in ids else 0
for event in events[start:]:
    for value in event:
        sys.stdout.buffer.write(value.encode() + b"\0")
PYTHON

while IFS= read -r -d '' EVENT_ID &&
      IFS= read -r -d '' STATUS &&
      IFS= read -r -d '' DETAIL; do
    ICON=system-software-update
    URGENCY=normal
    case "$STATUS" in
        RUNNING_DNF) TITLE="Mise à jour Fedora — Démarrage / DNF (1/3)" ;;
        RUNNING_FLATPAK) TITLE="Mise à jour Fedora — Flatpak (2/3)" ;;
        RUNNING_FIRMWARE) TITLE="Mise à jour Fedora — Firmware (3/3)" ;;
        SUCCESS) TITLE="Mise à jour Fedora terminée"; ICON=emblem-default ;;
        RECOMMENDATION) TITLE="Mise à jour Fedora — Recommandation"; ICON=dialog-information ;;
        ERROR) TITLE="Erreur pendant la mise à jour Fedora"; ICON=dialog-error; URGENCY=critical ;;
        *) continue ;;
    esac
    RECOMMENDATION_CACHE=""
    if [ "$STATUS" = RECOMMENDATION ]; then
        RECOMMENDATION_KEY="$(printf '%s' "$DETAIL" | sha256sum)"
        RECOMMENDATION_KEY="${RECOMMENDATION_KEY%% *}"
        BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
        RECOMMENDATION_CACHE="$CACHE_DIR/advice-$RECOMMENDATION_KEY"
        if [ -f "$RECOMMENDATION_CACHE" ] &&
           [ "$(cat "$RECOMMENDATION_CACHE")" = "$BOOT_ID" ]; then
            printf '%s\n' "$EVENT_ID" > "$CACHE_FILE"
            continue
        fi
    fi
    if ! notify-send --app-name="Fedora Update" --icon="$ICON" --urgency="$URGENCY" \
        --expire-time=15000 "$TITLE" "$DETAIL"; then
        printf 'Envoi de notification échoué pour %s (%s).\n' "$EVENT_ID" "$STATUS" >&2
        exit 1
    fi
    if [ -n "$RECOMMENDATION_CACHE" ]; then
        printf '%s\n' "$BOOT_ID" > "$RECOMMENDATION_CACHE"
    fi
    # Un événement n'est acquitté qu'après son envoi réussi.
    printf '%s\n' "$EVENT_ID" > "$CACHE_FILE.tmp"
    mv -f -- "$CACHE_FILE.tmp" "$CACHE_FILE"
done < "$EVENTS"
